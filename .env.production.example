# Production Environment Variables Template
# Copy this file and update with your actual values after deployment

# ============================================
# BACKEND (Render)
# ============================================
# Set these in Render Dashboard → Environment

MODE=offline
FLASK_PORT=5000
PYTHON_VERSION=3.11.0

# Update this after deploying frontend to Vercel
ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional: Reddit API (for future online mode)
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_secret_here
REDDIT_USER_AGENT=AI_Community_Dynamics_Research/1.0

# ============================================
# FRONTEND (Vercel)
# ============================================
# Set these in Vercel Dashboard → Environment Variables

# Update this with your actual Render backend URL
VITE_API_URL=https://ai-community-backend-XXXX.onrender.com
